spring.datasource.jndi-name=java:jboss/SigeredDS
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect
spring.jpa.show-sql=false
spring.datasource.initialize=false
spring.jpa.properties.org.hibernate.envers.audit_table_suffix=_SERVICES
spring.jpa.properties.hibernate.integration.envers.enabled=true
spring.jackson.time-zone=America/Guayaquil
spring.mvc.timezone=America/Guayaquil

#VARIABLES PARA SER LEIDAS:
WSDL.CodSistema=186
CorreoSistema=Generico.DesarrolloSistemaGestionDo@banecuador.fin.ec
EnlaceSistema=https://appswebdesarrollo.banecuador.fin.ec/sigered
url.notificaciones=https://appswebdesarrollo.banecuador.fin.ec/Notificaciones-web/NotificacionesWs?wsdl
seguridad.endpoint.login=https://appswebdesarrollo.banecuador.fin.ec/be-admin-proyectos-integracion-1.0.0/AutenticacionAutorizacionWS?wsdl
origin.allow=*

logger.implementacion=custom
directorio.documentos=/sigereddev
documentos.fileMaxSizeKb=2048
documentos.loteMaxSizeKb=2048
documentos.fileMaxQty=5
documentos.plantillasExcel=/reportes/plantillasExcel
documentos.maxAniosConservacion=10
plantillasExcel.InventarioDocumentos=PlantillaInventarioDocumentos.xlsx
workerExecutionTime=08:00
separador.archivos=/