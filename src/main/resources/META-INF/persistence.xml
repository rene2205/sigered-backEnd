<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.0" xmlns="http://java.sun.com/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd">
  <persistence-unit name="Sigered" transaction-type="JTA">
    <provider>org.hibernate.ejb.HibernatePersistence</provider>
    <jta-data-source>java:jboss/SigeredDS</jta-data-source>
    <class>ec.fin.be.sigered.repositorios.DoResolucionesDocumentoRepositorio</class>
    <class>ec.fin.be.sigered.dto.ResolucionDocumentoDto</class>
    <class>ec.fin.be.sigered.primary.entity.DoResolucionDocumento</class>
    <class>ec.fin.be.sigered.primary.entity.DoResolucion</class>
    <class>ec.fin.be.sigered.primary.entity.DoSolicitudCambioResolucion</class>
    <properties>
      <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect"/>
      <property name="hibernate.default_schema" value="res_documental"/>
      <property name="hibernate.show_sql" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
